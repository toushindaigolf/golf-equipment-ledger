# Copy this file to .env.local and replace only the values.
# VITE_ variables are bundled into the browser. Use a Publishable key only.
# Never put a Secret key or Service Role key in this file.
VITE_APP_ENV=local
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional public Google Forms URL. Leave blank until the form is ready.
VITE_CONTACT_FORM_URL=
